---
import { Image } from 'astro:assets';
import ManoloArchitecture from './ManoloArchitecture.astro';
import CapictiveArchitecture from './CapictiveArchitecture.astro';
import KromataArchitecture from './KromataArchitecture.astro';
import type { PortfolioProject } from '../data/portfolio';
interface Props { project: PortfolioProject; }
const { project } = Astro.props;
const reference = String(project.order).padStart(2, '0');
const statusLabels = { shipped: 'Built', 'in-development': 'In development', prototype: 'Prototype', archived: 'Archived' };
---
<article id={`${project.slug}-record`} class="project-card" aria-labelledby={`${project.slug}-heading`}>
  <div class="record-tab"><span class="record-reference">{reference}</span><span class="record-index-title">{project.displayTitle ?? project.title}</span><span class="record-tab-end">{project.category} / Selected work</span></div>
  <div class="record-reveal" id={`${project.slug}-content`}>
  <div class="record-content">
    <div class="record-top">
      <div class="project-heading">
        <div class="record-title-row">
          <h3 id={`${project.slug}-heading`}>{project.title}</h3>
          {project.coverMark && <Image class="project-stamp" src={project.coverMark} alt="" width={112} height={112} densities={[1, 2]} format="webp" fit="contain" loading="lazy" />}
        </div>
        <p class="project-subtitle">{project.subtitle}</p>
        <dl class="record-meta">
          {project.role && <div><dt>Role</dt><dd>{project.role}</dd></div>}
          {project.period && <div><dt>Period</dt><dd>{project.period}</dd></div>}
          {project.status && <div><dt>Status</dt><dd>{statusLabels[project.status]}</dd></div>}
          {project.codebase && <div><dt>Codebase</dt><dd>{project.codebase}</dd></div>}
        </dl>
      </div>
      {project.outline && <figure class="record-outline">
        <figcaption>Implementation outline</figcaption>
        <ol>{project.outline.map(step => <li><span class="outline-node" aria-hidden="true"></span><span>{step}</span></li>)}</ol>
      </figure>}
    </div>
    <div class="project-body">
      <div><h4>Context</h4><p>{project.summary}</p></div>
      <div class="implementation"><h4>Implementation</h4><p>{project.implementation}</p></div>
    </div>
    {project.metrics && <dl class="record-metrics" aria-label={`${project.title} project scope`}>
      {project.metrics.map(metric => <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}
    </dl>}
    {project.highlights && <div class="record-highlights"><h4>Project scope</h4><ul>{project.highlights.map(highlight => <li>{highlight}</li>)}</ul></div>}
    {project.recognition && <p class="record-recognition"><span aria-hidden="true">↳</span> {project.recognition}</p>}
    {project.slug === 'meowlab' && <ManoloArchitecture />}
    {project.slug === 'capictive' && <CapictiveArchitecture />}
    {project.slug === 'print-system' && <KromataArchitecture />}
    {project.designNotes && <section class="record-sources record-design" aria-label="System design and direction">
      <h4>System design & direction</h4>
      <div class="design-notes">{project.designNotes.map(note => <p>{note}</p>)}</div>
    </section>}
    <div class="project-bottom">
      <ul class="tags" aria-label={`${project.title} technologies`}>{project.tags.map(tag => <li>{tag}</li>)}</ul>
      <div class="project-links">
        {project.websiteUrl && <a href={project.websiteUrl} aria-label={`Visit ${project.title}`}>Visit project <span aria-hidden="true">↗</span></a>}
        {project.repositoryUrl && <a href={project.repositoryUrl} aria-label={`${project.repositoryLabel ?? 'Source code'} — ${project.title} on GitHub`}>{project.repositoryLabel ?? 'Source code'} <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </div>
  </div>
</article>

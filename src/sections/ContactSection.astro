---
import { profile } from '../data/portfolio';
---
<section id="contacto" class="section contact-section" aria-labelledby="contact-heading">
  <div><p class="eyebrow">Contact</p><h2 id="contact-heading">Let's build something useful.</h2><p>Have an engineering challenge or an idea to explore? Let's talk.</p></div>
  <div class="contact-links">
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
    <div class="text-links"><a href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a><a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a></div>
  </div>
</section>

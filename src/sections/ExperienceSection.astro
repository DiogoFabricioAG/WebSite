---
import { experience } from '../data/portfolio';
---
<section id="experiencia" class="section split-section" aria-labelledby="experience-heading">
  <div class="section-heading"><div><p class="eyebrow">Experience</p><h2 id="experience-heading">Built around real workflows.</h2></div></div>
  <div class="timeline">
    {experience.map(item => (
      <article class="experience-item">
        <div class="experience-meta"><p class="eyebrow">{item.kind}</p><p>{item.period}</p></div>
        <h3>{item.organization}</h3><p class="experience-role">{item.role}</p>
        <ul>{item.points.map(point => <li>{point}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

---
import { profile, communities, certifications } from '../data/portfolio';
import EducationSection from './EducationSection.astro';
---
<section id="sobre-mi" class="section" aria-labelledby="about-heading">
  <div class="section-heading"><div><p class="eyebrow">About</p><h2 id="about-heading">Curiosity, with a practical purpose.</h2></div></div>
  <div class="about-grid">
    <div class="about-copy">
      <p>{profile.about}</p><p>{profile.context}</p>
      <section class="certifications" aria-labelledby="certifications-heading">
        <h3 id="certifications-heading" class="eyebrow">Certifications</h3>
        {certifications.map(item => <article class="certification-item"><p class="small-text">{item.issuer} / {item.date}</p><h4>{item.title}</h4><a class="certification-link" href={item.url}>View credential <span aria-hidden="true">↗</span></a></article>)}
      </section>
      <div class="community-block">
        <h3 class="eyebrow">Community</h3>
        {communities.map(community => <article class="community-note">
          <h4>{community.organization}</h4><p class="community-role">{community.role}</p>
          {community.period && <p class="small-text">{community.period}</p>}
          <p>{community.description}</p>
        </article>)}
      </div>
      <div class="languages"><h3 class="eyebrow">Languages</h3><dl>{profile.languages.map(item => <div><dt>{item.language}</dt><dd>{item.level}</dd></div>)}</dl></div>
    </div>
    <EducationSection />
  </div>
</section>

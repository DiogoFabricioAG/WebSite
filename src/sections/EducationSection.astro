---
import { Image } from 'astro:assets';
import { education } from '../data/portfolio';
---
<div id="educacion" class="education" aria-labelledby="education-heading">
  <h3 id="education-heading" class="eyebrow">Education & learning</h3>
  {education.map(item => (
    <article class="education-item">
      <Image src={item.logo} width={72} height={72} densities={[1, 2]} format="webp" fit="contain" alt="" loading="lazy" />
      <div><h4>{item.institution}</h4><p class="education-program">{item.program}</p><p class="small-text">{item.period}</p><p>{item.detail}</p>{item.note && <p class="education-note">{item.note}</p>}</div>
    </article>
  ))}
</div>

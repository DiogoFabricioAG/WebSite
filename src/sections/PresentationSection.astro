---
import { Image } from 'astro:assets';
import { profile, projects, experience, education, certifications, relatedWork } from '../data/portfolio';
const selected = projects.filter(project => project.featured).sort((a, b) => a.order - b.order);
const llmPrompt = [
  'Who is Diogo Abregu? Based only on the portfolio context below, summarize his background, technical strengths, notable work, and the kinds of software engineering roles that fit his experience. Distinguish ongoing work from completed work and do not invent details.',
  '',
  `Portfolio: ${Astro.site ? new URL('/', Astro.site).href : 'https://www.diogoabregu.tech/'}`,
  `Profile: ${profile.introduction} ${profile.about}`,
  '',
  'Selected projects:',
  ...selected.map(project => `- ${project.title}${project.role ? ` (${project.role})` : ''}${project.status === 'in-development' ? ' [in development]' : ''}: ${project.summary} ${project.implementation}`),
  '',
  'Further work:',
  ...relatedWork.map(work => `- ${work.title}: ${work.summary}`),
  '',
  'Experience:',
  ...experience.map(item => `- ${item.organization}, ${item.role} (${item.period}): ${item.points.join(' ')}`),
  '',
  'Education:',
  ...education.map(item => `- ${item.institution}: ${item.program} (${item.period}). ${item.detail}`),
  ...certifications.map(item => `- Certification: ${item.title}, ${item.issuer} (${item.date}).`),
  `Languages: ${profile.languages.map(item => `${item.language} (${item.level})`).join(', ')}.`,
].join('\n');
---
<section id="inicio" class="hero" aria-labelledby="hero-heading">
  <dialog class="archive-welcome" aria-labelledby="welcome-title" aria-describedby="welcome-description" data-archive-welcome>
    <div class="welcome-inner">
      <div class="welcome-register"><span>Personal archive / 001</span><span>Software & AI systems</span></div>
      <div class="welcome-file">
        <div class="welcome-folder">
          <div class="welcome-folder-back" aria-hidden="true"><span>001 / PERSONAL ARCHIVE</span></div>
          <div class="welcome-sheet" aria-hidden="true"><span>PERSONAL ARCHIVE</span><span>SOFTWARE / AI SYSTEMS</span><i></i><i></i><i></i></div>
          <button type="button" class="welcome-folder-cover" data-enter-sound aria-describedby="welcome-description">
            <span class="welcome-cover-top"><span>PERSONAL ARCHIVE</span><span>DA / 001</span></span>
            <span class="welcome-cover-label"><span>FILE UNDER</span><strong id="welcome-title">Diogo Abregu<span>.</span></strong><span>SOFTWARE ENGINEERING / APPLIED INTELLIGENCE</span></span>
            <span class="welcome-cover-bottom"><span>OPEN THE ARCHIVE <span aria-hidden="true">↗</span></span><span>SOUND ON</span></span>
          </button>
        </div>
        <p id="welcome-description" class="welcome-description">Open the folder to begin with sound.</p>
        <div class="welcome-actions">
          <button type="button" class="welcome-silent" data-enter-silent>Enter without sound <span aria-hidden="true">→</span></button>
        </div>
      </div>
      <div class="welcome-footer"><span>Independent work / Peru</span><span>Sound on by choice</span></div>
    </div>
  </dialog>
  <div class="hero-register">
    <p class="eyebrow">Software engineering / Applied intelligence</p>
    <span class="archive-location">Peru <span aria-hidden="true">↗</span> Working across systems</span>
  </div>
  <h1 id="hero-heading" class="hero-name-display" tabindex="-1"><span class="name-window"><span class="name-word">{[...'Diogo'].map((letter, i) => <span class="name-letter" style={`--letter-index:${i}`}>{letter}</span>)}</span></span> <span class="name-window"><span class="name-word">{[...'Abregu'].map((letter, i) => <span class="name-letter" style={`--letter-index:${i + 5}`}>{letter}</span>)}<span class="name-letter" style="--letter-index:11"><button type="button" class="name-period" data-replay-opening aria-label="Replay opening" title="Replay opening">.</button></span></span></span></h1>
  <div class="hero-stage">
    <div class="hero-copy">
      <p class="eyebrow hero-field">The person behind the systems</p>
      <h2>{profile.headline.lead}<br /><span>{profile.headline.accent}</span></h2>
      <p class="hero-intro">{profile.archiveIntroduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#proyectos">Explore the archive <span aria-hidden="true">↓</span></a>
        <button type="button" class="button button-copy" data-copy-llm hidden><span data-copy-label>Copy to LLM</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="11" height="12" rx="1"/><path d="M16 8V5a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h2"/></svg></button>
        <a class="action-icon" href={profile.github} aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.93c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.72.39-1.22.7-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.45 3.09-1.15 3.09-1.15.62 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z"/></svg></a>
        <a class="action-icon" href={profile.linkedin} aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.25 9h3.5v11.75h-3.5V9Zm5.8 0h3.35v1.6h.05a3.68 3.68 0 0 1 3.3-1.82c3.53 0 4.18 2.32 4.18 5.34v6.63h-3.5v-5.88c0-1.4-.03-3.2-1.96-3.2-1.96 0-2.26 1.52-2.26 3.1v5.98h-3.5V9Z"/></svg></a>
        <a class="action-icon" href={profile.resume} download aria-label="Download résumé / CV" title="Download résumé / CV"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v5h4M9 12h6M9 15h6M9 18h4"/></svg></a>
      </div>
      <span class="visually-hidden" data-copy-status role="status" aria-live="polite"></span>
      <label class="copy-fallback" data-copy-fallback hidden>Copy the prompt below:<textarea data-copy-prompt readonly rows="5">{llmPrompt}</textarea></label>
    </div>
    <aside class="hero-exhibit" aria-label="Featured project">
      <div class="folder-stack" data-archive-preview>
        <div class="folder-backing backing-three" aria-hidden="true"><span>03 / Kromata System</span></div>
        <div class="folder-backing backing-two" aria-hidden="true"><span>02 / Capictive</span></div>
        {selected.map((project, index) => <a class="cover-file" data-record={project.slug} href={`#${project.slug}-record`} hidden={index !== 0}>
          <div class="file-register"><span>Record / {String(project.order).padStart(2, '0')}</span><span aria-hidden="true">↗</span></div>
          {project.coverMark ? <Image class="cover-logo" src={project.coverMark} width={88} height={88} densities={[1, 2]} format="webp" alt="" loading="eager" /> : <div class="cover-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>}
          <div class="cover-file-title">{project.displayTitle ?? project.title}<span>{project.category}</span></div>
          <p>{project.subtitle}</p>
          <div class="file-bottom"><span>Open record</span><span>Code & implementation</span></div>
        </a>)}
      </div>
    </aside>
  </div>
  <nav class="archive-index" aria-label="Selected project index">
    {selected.map(project => (
      <a href={`#${project.slug}-record`} data-record={project.slug}>
        <span class="index-number">{String(project.order).padStart(2, '0')}</span>
        <span class="index-title">{project.displayTitle ?? project.title}<span>{project.category}</span></span>
        <span class="index-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-llm]');
  if (copyButton) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', () => {
      const input = document.querySelector<HTMLTextAreaElement>('[data-copy-prompt]');
      let result = Promise.resolve(false);
      try { if (input && navigator.clipboard?.writeText) result = navigator.clipboard.writeText(input.value).then(() => true, () => false); } catch {}
      void import('../utils/copy-llm').then(({ copyLlmPrompt }) => copyLlmPrompt(result)).catch(() => {
        const fallback = document.querySelector<HTMLElement>('[data-copy-fallback]');
        const prompt = document.querySelector<HTMLTextAreaElement>('[data-copy-prompt]');
        const status = document.querySelector<HTMLElement>('[data-copy-status]');
        if (fallback && prompt && status) { fallback.hidden = false; status.textContent = 'Select and copy the prompt below.'; prompt.focus(); prompt.select(); }
      });
    });
  }
  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('.hero');
  const replay = document.querySelector<HTMLButtonElement>('[data-replay-opening]');
  const welcome = document.querySelector<HTMLDialogElement>('[data-archive-welcome]');
  let soundEnabled = root.dataset.archiveOpening !== 'pending';
  try { if (sessionStorage.getItem('diogo-archive-sound') === 'off') soundEnabled = false; } catch {}
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const heading = document.querySelector<HTMLElement>('.hero-name-display');
  function positionOpeningName() {
    if (!heading) return;
    const rect = heading.getBoundingClientRect();
    const transform = getComputedStyle(heading).transform;
    const currentOffset = transform === 'none' ? 0 : new DOMMatrixReadOnly(transform).m42;
    const naturalBottom = rect.bottom - currentOffset;
    heading.style.setProperty('--opening-offset', `${Math.max(0, window.innerHeight - naturalBottom - 24)}px`);
  }
  positionOpeningName();
  let openingTimer: number | undefined;
  let letterTimers: number[] = [];
  const letters = document.querySelectorAll<HTMLElement>('.name-letter');
  let keyboardAudio: AudioContext | undefined;
  let keyboardBuffer: AudioBuffer | undefined;
  let folderBuffer: AudioBuffer | undefined;
  let penBuffer: AudioBuffer | undefined;
  let interfaceSource: AudioBufferSourceNode | undefined;
  let folderSource: AudioBufferSourceNode | undefined;
  let lastFolderSoundAt = -Infinity;
  let folderPreparation: Promise<void> | undefined;
  let chimeGain: GainNode | undefined;
  const keyboardSample = fetch('/sounds/kliq-oem/30-down.wav').then(response => {
    if (!response.ok) throw new Error('Keyboard sample unavailable');
    return response.arrayBuffer();
  }).catch(() => undefined);
  const folderSample = fetch('/sounds/folder/page-turn.wav').then(response => {
    if (!response.ok) throw new Error('Folder sound unavailable');
    return response.arrayBuffer();
  }).catch(() => undefined);
  const penSample = fetch('/sounds/interface/pen-click.wav').then(response => response.ok ? response.arrayBuffer() : undefined).catch(() => undefined);
  function prepareFolderAudio() {
    if (folderBuffer && penBuffer && keyboardAudio?.state === 'running') return Promise.resolve();
    if (folderPreparation) return folderPreparation;
    folderPreparation = (async () => {
      try {
        keyboardAudio ??= new AudioContext();
        await keyboardAudio.resume();
        const [folder, pen] = await Promise.all([folderSample, penSample]);
        if (folder && !folderBuffer) folderBuffer = await keyboardAudio.decodeAudioData(folder.slice(0));
        if (pen && !penBuffer) penBuffer = await keyboardAudio.decodeAudioData(pen.slice(0));
      } catch {} finally { folderPreparation = undefined; }
    })();
    return folderPreparation;
  }
  function playFolderTurn() {
    if (!soundEnabled || !keyboardAudio || keyboardAudio.state !== 'running' || !folderBuffer) return;
    if (folderSource) { try { folderSource.stop(); } catch {} }
    const source = keyboardAudio.createBufferSource();
    const volume = keyboardAudio.createGain();
    source.buffer = folderBuffer;
    volume.gain.value = .2;
    source.connect(volume).connect(keyboardAudio.destination);
    folderSource = source;
    source.onended = () => { if (folderSource === source) folderSource = undefined; };
    source.start();
    lastFolderSoundAt = performance.now();
  }
  function playInterfaceSound(kind: 'hover' | 'click') {
    if (!keyboardAudio || keyboardAudio.state !== 'running') return;
    const context = keyboardAudio;
    const buffer = kind === 'hover' ? folderBuffer : penBuffer;
    if (!buffer) return;
    if (interfaceSource) { try { interfaceSource.stop(); } catch {} }
    const source = context.createBufferSource();
    const volume = context.createGain();
    source.buffer = buffer;
    const duration = kind === 'hover' ? .16 : buffer.duration;
    const now = context.currentTime;
    volume.gain.setValueAtTime(.0001, now);
    volume.gain.linearRampToValueAtTime(kind === 'hover' ? .10 : .35, now + .004);
    volume.gain.setValueAtTime(kind === 'hover' ? .10 : .35, now + duration - .02);
    volume.gain.linearRampToValueAtTime(.0001, now + duration);
    source.connect(volume).connect(context.destination);
    interfaceSource = source;
    source.onended = () => { source.disconnect(); volume.disconnect(); if (interfaceSource === source) interfaceSource = undefined; };
    if (kind === 'hover') source.start(now, .30, duration);
    else source.start(now);
  }
  async function enableKeyboardAudio() {
    try {
      keyboardAudio ??= new AudioContext();
      await keyboardAudio.resume();
      const sample = await keyboardSample;
      if (sample && !keyboardBuffer) keyboardBuffer = await keyboardAudio.decodeAudioData(sample.slice(0));
    } catch {}
  }
  function playKey() {
    if (!soundEnabled || !keyboardAudio || keyboardAudio.state !== 'running' || !keyboardBuffer) return;
    const now = keyboardAudio.currentTime;
    const source = keyboardAudio.createBufferSource();
    const volume = keyboardAudio.createGain();
    source.buffer = keyboardBuffer;
    volume.gain.value = .3;
    source.connect(volume).connect(keyboardAudio.destination);
    source.start(now);
  }
  function playWelcome() {
    if (!soundEnabled || !keyboardAudio || keyboardAudio.state !== 'running') return;
    const context = keyboardAudio;
    const start = context.currentTime;
    const master = context.createGain();
    master.gain.value = .13;
    master.connect(context.destination);
    chimeGain = master;
    [392, 493.88, 587.33, 783.99].forEach((frequency, index) => {
      const time = start + index * .16;
      const tone = context.createOscillator();
      const envelope = context.createGain();
      tone.type = 'sine';
      tone.frequency.value = frequency;
      envelope.gain.setValueAtTime(.0001, time);
      envelope.gain.exponentialRampToValueAtTime(.7, time + .06);
      envelope.gain.exponentialRampToValueAtTime(.0001, time + 1.05);
      tone.connect(envelope).connect(master);
      tone.start(time);
      tone.stop(time + 1.06);
      if (index === 3) tone.onended = () => { master.disconnect(); if (chimeGain === master) chimeGain = undefined; };
    });
  }
  function writeName() {
    letterTimers.forEach(window.clearTimeout);
    letters.forEach((letter, index) => {
      letter.classList.remove('is-written');
      letterTimers.push(window.setTimeout(() => { letter.classList.add('is-written'); playKey(); }, 250 + index * 110));
    });
    letterTimers.push(window.setTimeout(playWelcome, 2800));
  }

  function finishOpening() {
    if (root.dataset.archiveOpening === 'pending') return;
    window.clearTimeout(openingTimer);
    letterTimers.forEach(window.clearTimeout);
    letterTimers = [];
    if (chimeGain && keyboardAudio) { chimeGain.gain.setTargetAtTime(0, keyboardAudio.currentTime, .03); chimeGain = undefined; }
    if (root.dataset.archiveOpening === 'full') {
      try { sessionStorage.setItem('diogo-archive-opening-v1', '1'); } catch {}
    }
    delete root.dataset.archiveOpening;
  }

  function startOpening(mode: 'full' | 'brief') {
    finishOpening();
    if (reducedMotion.matches || !hero) return;
    positionOpeningName();
    // Flush only when explicitly restarting, so CSS gets a fresh animation timeline.
    void hero.offsetWidth;
    root.dataset.archiveOpening = mode;
    if (mode === 'full') writeName();
    openingTimer = window.setTimeout(finishOpening, mode === 'full' ? 4450 : 350);
  }

  if (root.dataset.archiveOpening === 'pending' && welcome) {
    welcome.showModal();
    const enter = async (withSound: boolean) => {
      if (!welcome.open) return;
      soundEnabled = withSound;
      welcome.querySelectorAll('button').forEach(button => { button.disabled = true; });
      const audioReady = withSound ? Promise.race([enableKeyboardAudio(), new Promise(resolve => setTimeout(resolve, 2000))]) : Promise.resolve();
      welcome.classList.add('is-opening');
      await Promise.all([audioReady, new Promise(resolve => setTimeout(resolve, reducedMotion.matches ? 0 : 700))]);
      try { sessionStorage.setItem('diogo-archive-opening-v1', '1'); sessionStorage.setItem('diogo-archive-sound', withSound ? 'on' : 'off'); } catch {}
      const reveal = () => {
        delete root.dataset.archiveOpening;
        welcome.close();
        heading?.focus({ preventScroll: true });
      };
      if (!reducedMotion.matches && document.startViewTransition) {
        root.classList.add('archive-handoff');
        void document.startViewTransition(() => { reveal(); root.dataset.archiveOpening = 'staged'; }).finished.finally(() => {
          root.classList.remove('archive-handoff');
          startOpening('full');
        });
      } else { reveal(); startOpening('full'); }
    };
    welcome.querySelector('[data-enter-sound]')?.addEventListener('click', () => { void enter(true); });
    welcome.querySelector('[data-enter-silent]')?.addEventListener('click', () => { void enter(false); });
    welcome.addEventListener('cancel', event => { event.preventDefault(); void enter(false); });
  }
  const opening = root.dataset.archiveOpening;
  if (navigator.userActivation?.hasBeenActive) void prepareFolderAudio();
  if (opening === 'full' || opening === 'brief') {
    if (opening === 'full') writeName();
    if (opening === 'full' && navigator.userActivation?.hasBeenActive) void enableKeyboardAudio();
    openingTimer = window.setTimeout(finishOpening, opening === 'full' ? 4450 : 350);
  }
  if (replay) {
    replay.disabled = reducedMotion.matches;
    replay.addEventListener('click', async () => { if (soundEnabled) await enableKeyboardAudio(); startOpening('full'); });
  }
  reducedMotion.addEventListener('change', () => {
    finishOpening();
    if (replay) replay.disabled = reducedMotion.matches;
  });
  window.addEventListener('pageshow', event => { if (event.persisted) finishOpening(); });
  window.addEventListener('keydown', event => { if (event.key === 'Escape' || event.key === 'Tab') finishOpening(); });
  window.addEventListener('pointerdown', finishOpening, { passive: true });
  window.addEventListener('pointerdown', event => {
    if (!soundEnabled || root.dataset.archiveOpening === 'pending') return;
    const ready = prepareFolderAudio();
    if (event.pointerType !== 'mouse' || event.button !== 0) return;
    if (keyboardAudio?.state === 'running' && penBuffer) playInterfaceSound('click');
    else void ready.then(() => playInterfaceSound('click'));
  }, { passive: true });
  window.addEventListener('keydown', () => { if (soundEnabled && root.dataset.archiveOpening !== 'pending') void prepareFolderAudio(); }, { passive: true });
  document.addEventListener('pointerover', event => {
    if (!soundEnabled) return;
    if (event.pointerType === 'touch' || !(event.target instanceof Element)) return;
    const control = event.target.closest('a[href], button:not([disabled]), summary');
    if (!control || control.closest('.archive-index, [data-archive-preview]')) return;
    if (event.relatedTarget instanceof Node && control.contains(event.relatedTarget)) return;
    playInterfaceSound('hover');
  });

  void import('../utils/archive-preview').then(({ setupArchivePreview }) => setupArchivePreview(playFolderTurn, () => lastFolderSoundAt, reducedMotion, root));
</script>

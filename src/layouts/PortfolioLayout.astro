---
import '../styles/portfolio.css';
import { profile } from '../data/portfolio';

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social-card.png', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: new URL('/', Astro.site).href,
  description: profile.description,
  sameAs: [profile.github, profile.linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#102a2c" />
    <meta name="google-site-verification" content="9kPvdhpn-6LIdnMmFriTqAbL78ntBuwZukZDCppsQMw" />
    <title>{profile.title}</title>
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      html[data-archive-opening="pending"], html[data-archive-opening="staged"], html[data-archive-opening="full"] { overflow: hidden; }
      html[data-archive-opening="pending"] body { visibility: hidden; }
      html[data-archive-opening="pending"] .archive-welcome[open] { visibility: visible; }
    </style>
    <script is:inline>
      (() => {
        if (location.hash) return;
        try { if (sessionStorage.getItem('diogo-archive-opening-v1')) return; } catch {}
        document.documentElement.dataset.archiveOpening = 'pending';
        setTimeout(() => {
          if (document.documentElement.dataset.archiveOpening === 'pending' && !document.querySelector('[data-archive-welcome][open]')) {
            delete document.documentElement.dataset.archiveOpening;
          }
        }, 5000);
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/iconopq.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={profile.title} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Diogo Abregu — Software Engineering & AI Systems" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={profile.title} />
    <meta name="twitter:description" content={profile.description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
